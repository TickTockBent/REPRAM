# Build context for this Dockerfile is repo-root/repram-mcp/.
FROM node:18-alpine

ARG TEST_OMEGA_PUBKEY
RUN test -n "$TEST_OMEGA_PUBKEY" || (echo "TEST_OMEGA_PUBKEY build-arg is required" >&2 && exit 2)

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --production=false

COPY tsconfig.json ./
COPY src/ ./src/

# Replace the placeholder pubkey in src/node/trust/omega.ts before tsc compiles
# it. The placeholder is unique enough that this single substitution is safe.
RUN sed -i "s|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=|${TEST_OMEGA_PUBKEY}|" src/node/trust/omega.ts && \
    grep -q "${TEST_OMEGA_PUBKEY}" src/node/trust/omega.ts || \
    (echo "pubkey bake failed" >&2 && exit 3)

RUN npm run build
RUN npm prune --production

RUN mkdir -p /data/cache
ENV REPRAM_CACHE_DIR=/data/cache
ENV REPRAM_MODE=standalone

EXPOSE 8080 9090
ENTRYPOINT ["node", "dist/index.js"]
